{
  "name": "@firemail/server",
  "version": "2.1.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "test": "node --test --experimental-strip-types \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^10.1.3",
    "@firemail/shared": "workspace:*",
    "better-sqlite3": "^11.8.1",
    "dompurify": "^3.4.14",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.2.1",
    "imapflow": "^1.0.187",
    "jsdom": "^26.1.0",
    "nodemailer": "^10.0.0",
    "pino": "^9.6.0",
    "postal-mime": "^2.4.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.10.7",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
