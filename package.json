{
  "name": "firemail",
  "version": "2.1.3",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --filter @firemail/shared build && pnpm --filter @firemail/web build && pnpm --filter @firemail/server build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "release": "node tools/release.mjs"
  }
}
